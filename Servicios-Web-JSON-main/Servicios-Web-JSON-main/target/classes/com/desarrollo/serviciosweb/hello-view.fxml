<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.desarrollo.serviciosweb.controller.UsuariosController">
    <padding>
        <Insets bottom="16.0" left="16.0" right="16.0" top="16.0"/>
    </padding>

    <Label text="Consulta de usuarios - API REST" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <HBox alignment="CENTER_LEFT" spacing="12.0">
        <Button fx:id="btnConsultar" onAction="#onConsultarUsuarios" text="Consultar usuarios"/>
        <Label fx:id="lblEstado" text="Presione Consultar usuarios"/>
    </HBox>

    <TableView fx:id="tablaUsuarios" prefHeight="420.0" prefWidth="900.0" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId" prefWidth="60.0" text="ID">
                <cellValueFactory><PropertyValueFactory property="id"/></cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="colNombre" prefWidth="160.0" text="Nombre">
                <cellValueFactory><PropertyValueFactory property="nombre"/></cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="colUsername" prefWidth="120.0" text="Username">
                <cellValueFactory><PropertyValueFactory property="username"/></cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="colEmail" prefWidth="180.0" text="Email">
                <cellValueFactory><PropertyValueFactory property="email"/></cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="colTelefono" prefWidth="120.0" text="Teléfono">
                <cellValueFactory><PropertyValueFactory property="telefono"/></cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="colCiudad" prefWidth="110.0" text="Ciudad">
                <cellValueFactory><PropertyValueFactory property="ciudad"/></cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="colEmpresa" prefWidth="150.0" text="Empresa">
                <cellValueFactory><PropertyValueFactory property="empresa"/></cellValueFactory>
            </TableColumn>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>
</VBox>

# Copie este archivo como "supabase.local.properties" (excluido de git) en la raíz del proyecto.
# Alternativa: variables de entorno SUPABASE_PUBLISHABLE_KEY y SUPABASE_ACCESS_TOKEN.
# Use solo la clave publicable (sb_publishable_... o anon). Nunca la clave secreta ni service_role.
supabase.publishableKey=
# Opcional: token JWT de un usuario autenticado, solo si las políticas RLS lo exigen.
supabase.accessToken=
